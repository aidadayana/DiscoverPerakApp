<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black">

    <!-- MAIN CONTAINER (must be only ONE child of ScrollView) -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="43dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/backicon"
                android:tint="@color/topbar_icon" />

            <!-- Title -->
            <TextView
                android:id="@+id/foodTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Attraction"
                android:textColor="@color/topbar_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <!-- Home Button -->
            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="45dp"
                android:layout_height="43dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/homebtn"
                android:tint="@color/topbar_icon" />
        </LinearLayout>


        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/squarebg"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="47dp"
                android:layout_height="53dp"
                android:src="@drawable/searchicon"
                android:tint="@null" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint=" Search places..."
                android:inputType="text"
                android:paddingLeft="10dp"
                android:textColor="#000000"
                android:textColorHint="#777777" />
        </LinearLayout>

        <!-- RECOMMENDATION CARDS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:paddingLeft="16dp"
            android:text="Recommendation"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ALL CARDS CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD 1 -->
            <LinearLayout
                android:id="@+id/cardgununghijau"
                android:layout_width="wrap_content"
                android:layout_height="247dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gununghijau"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gunung Hijau"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ipoh, Perak"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <!-- CARD 2 -->
            <LinearLayout
                android:id="@+id/cardmarina"
                android:layout_width="wrap_content"
                android:layout_height="251dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/marinaisland"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marina Island"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lumut, Manjung, Perak"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <!-- CARD 3 -->
            <LinearLayout
                android:id="@+id/cardkelliescastle"
                android:layout_width="wrap_content"
                android:layout_height="252dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/kellcastle"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kellie's Castle"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ipoh, Perak"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <!-- CARD 4 -->
            <LinearLayout
                android:id="@+id/cardcondong"
                android:layout_width="wrap_content"
                android:layout_height="247dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/menaracondong"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menara Condong"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teluk Intan, Perak"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

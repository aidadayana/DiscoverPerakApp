<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="43dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/backicon"
                android:tint="@color/topbar_icon" />

            <!-- Title -->
            <TextView
                android:id="@+id/foodTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Food Place"
                android:textColor="@color/topbar_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <!-- Home Button -->
            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="45dp"
                android:layout_height="43dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/homebtn"
                android:tint="@color/topbar_icon" />/>
        </LinearLayout>

        <!-- CARD BUTTON -->
        <LinearLayout
            android:id="@+id/cardmiker"
            android:layout_width="350dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:layout_marginBottom="0dp"
            android:background="@drawable/smallbg"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:clickable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miker Restaurant"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MAIN CONTENT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/longsquarebox"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="60dp"
            android:paddingEnd="32dp"
            android:paddingBottom="65dp">

            <!-- IMAGE SLIDER -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/imageRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="12dp"
                android:overScrollMode="never" />

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miker Restaurant"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- LOCATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Riverwalk Kinta, Ipoh"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- OPERATION HOURS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="🕒 Operation Hours"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="• Monday – Sunday: 4:00 PM – 12:00 AM"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- ABOUT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ About Miker Food Restaurant"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miker Food Restaurant is a popular dining spot in Ipoh known for its relaxing atmosphere and delicious selection of local and Western dishes. You can visit their official website to view the menu and order online."
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- POPULAR MENU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽️ Popular Menu"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Grilled chicken chop with black pepper sauce"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Lamb chop and beef steak"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Pasta (carbonara, aglio olio, bolognese)"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Burgers, fries, and refreshing beverages"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </LinearLayout>


            <!-- Average Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Average Price"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Food and drinks: RM 20 – RM 40 per person"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- VIDEO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Click to watch a short video of Miker"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp"
                android:gravity="center">

                <VideoView
                    android:id="@+id/videoView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/playicon"
                    android:background="@android:color/transparent"
                    android:clickable="true" />
            </FrameLayout>


            <!-- CONTACT INFO TABLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"
                android:layout_marginBottom="12dp">

                <!-- Website Row -->
                <TableRow
                    android:background="@android:color/white">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🌐 Website"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="https://mikerfood.com/"
                        android:autoLink="web"
                        android:linksClickable="true"
                        android:textColor="#000000" />
                </TableRow>

                <!-- Contact Number Row -->
                <TableRow
                    android:background="@android:color/white">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="📞 Phone"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="+60 11-1030 0033"
                        android:textColor="@android:color/black" />
                </TableRow>
            </TableLayout>


            <!-- MAP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Location"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/mapImageView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/miker_map"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#000000"
                android:contentDescription="Map to Miker Restaurant" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

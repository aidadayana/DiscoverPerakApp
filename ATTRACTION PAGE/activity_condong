<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black">

  <!-- MAIN CONTAINER -->
  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

      <!-- Back Button -->
      <ImageView
          android:id="@+id/btnBack"
          android:layout_width="45dp"
          android:layout_height="43dp"
          android:clickable="true"
          android:focusable="true"
          android:padding="2dp"
          android:src="@drawable/backicon"
          android:tint="@color/topbar_icon" />

      <!-- Title -->
      <TextView
          android:id="@+id/foodTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:text="Attraction"
          android:textColor="@color/topbar_text"
          android:textSize="27sp"
          android:textStyle="bold" />

      <!-- Home Button -->
      <ImageView
          android:id="@+id/btnHome"
          android:layout_width="45dp"
          android:layout_height="43dp"
          android:clickable="true"
          android:focusable="true"
          android:padding="2dp"
          android:src="@drawable/homebtn"
          android:tint="@color/topbar_icon" />
    </LinearLayout>

    <!-- CARD BUTTON -->
    <LinearLayout
        android:id="@+id/cardcondong"
        android:layout_width="350dp"
        android:layout_height="66dp"
        android:layout_gravity="center"
        android:layout_marginBottom="0dp"
        android:background="@drawable/smallbg"
        android:clickable="true"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Menara Condong"
          android:textColor="#000000"
          android:textSize="18sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN CONTENT CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/longsquarebox"
        android:elevation="10dp"
        android:minHeight="50dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="60dp"
        android:paddingEnd="32dp"
        android:paddingBottom="65dp">


      <!-- IMAGE SCROLL -->

      <!-- TITLE -->

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/imageRecyclerView"
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:layout_marginBottom="12dp"
          android:overScrollMode="never" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="Menara Condong"
          android:textColor="#000000"
          android:textSize="20sp"
          android:textStyle="bold" />

      <!-- LOCATION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="📍 Teluk Intan, Perak"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- OPERATION HOURS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🕒 Operation Hours"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Monday – Sunday: 8:00 AM – 6:00 PM"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- TICKETING -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🎟️ Ticketing"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Adult (Malaysian): RM 2.00"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Child (Malaysian): RM 1.00"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Ticket prices may vary during special events or holidays"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- DESCRIPTION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="ℹ️ About Menara Condong Teluk Intan"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="Menara Condong Teluk Intan is a historic leaning clock tower located in Teluk Intan, Perak. Built in 1885 during the British colonial era, it was originally used as a water tank before serving as a clock tower. Standing at 25.5 meters tall with 110 steps leading to the top, the tower features a square base inspired by Chinese pagoda architecture. Its distinctive tilt is caused by uneven ground settlement and underground water flow, making it one of Perak’s most iconic heritage landmarks."
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- MAIN ATTRACTIONS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="⭐ Main Attractions"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Famous leaning clock tower architecture"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Historical exhibits inside the tower"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Surrounding heritage streets and shops"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- ACTIVITIES -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🚴 Activities"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Sightseeing and historical exploration"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Photography of the leaning tower"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Visiting nearby food stalls and local markets"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- FACILITIES -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🚻 Facilities Nearby"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Public parking areas\n• Food stalls and local eateries\n• Souvenir shops\n• Public restrooms"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- VIDEO VIEW -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="🎬 Video "
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <!-- VIDEO DESCRIPTION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:text="Click to watch a short video of Menara Condong"
          android:textColor="#000000"
          android:textSize="14sp" />

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:layout_marginBottom="6dp">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/playicon" />
      </FrameLayout>


      <!-- MAP IMAGE -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="📍 Location"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <ImageView
          android:id="@+id/mapImageView"
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:clickable="true"
          android:contentDescription="Map to Menara Condong"
          android:textColor="#000000"
          android:focusable="true"
          android:scaleType="centerCrop"
          android:src="@drawable/condong_map" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black">

  <!-- MAIN CONTAINER -->
  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

      <!-- Back Button -->
      <ImageView
          android:id="@+id/btnBack"
          android:layout_width="45dp"
          android:layout_height="43dp"
          android:clickable="true"
          android:focusable="true"
          android:padding="2dp"
          android:src="@drawable/backicon"
          android:tint="@color/topbar_icon" />

      <!-- Title -->
      <TextView
          android:id="@+id/foodTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:text="Attraction"
          android:textColor="@color/topbar_text"
          android:textSize="27sp"
          android:textStyle="bold" />

      <!-- Home Button -->
      <ImageView
          android:id="@+id/btnHome"
          android:layout_width="45dp"
          android:layout_height="43dp"
          android:clickable="true"
          android:focusable="true"
          android:padding="2dp"
          android:src="@drawable/homebtn"
          android:tint="@color/topbar_icon" />
    </LinearLayout>

    <!-- CARD BUTTON -->
    <LinearLayout
        android:id="@+id/cardgununghijau"
        android:layout_width="350dp"
        android:layout_height="66dp"
        android:layout_gravity="center"
        android:layout_marginBottom="0dp"
        android:background="@drawable/smallbg"
        android:clickable="true"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="0dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Gunung Hijau"
          android:textColor="#000000"
          android:textSize="18sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN CONTENT CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/longsquarebox"
        android:elevation="10dp"
        android:minHeight="50dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="60dp"
        android:paddingEnd="32dp"
        android:paddingBottom="60dp">


      <!-- IMAGE SCROLL -->

      <!-- TITLE -->

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/imageRecyclerView"
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:layout_marginBottom="12dp"
          android:overScrollMode="never" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="Gunung Hijau"
          android:textColor="#000000"
          android:textSize="20sp"
          android:textStyle="bold" />

      <!-- LOCATION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="📍 Gunung Hijau, Perak"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- OPERATION HOURS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🕒 Operation Hours"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Monday – Sunday: 7:00 AM – 5:00 PM"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- DESCRIPTION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="ℹ️ About Gunung Hijau"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="Gunung Hijau is a scenic hill located in Perak, standing at approximately 800 meters above sea level. Known for its lush greenery, cool climate, and panoramic views, it is a favorite spot for nature lovers, hikers, and photographers. Visitors can enjoy refreshing waterfalls, forest trails, and breathtaking lookout points while experiencing the peaceful atmosphere of this natural retreat."
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- MAIN ATTRACTIONS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="⭐ Main Attractions"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Panoramic hilltop views and lush forests"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Refreshing waterfalls and streams"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Observation decks and photo spots"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Forest trails for hiking and exploration"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- ACTIVITIES -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="🚴 Activities"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Hiking and nature walks"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Photography of hills, waterfalls, and wildlife"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="• Birdwatching and wildlife spotting"
          android:textColor="#000000"
          android:textSize="14sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:text="• Family picnics and outdoor relaxation"
          android:textColor="#000000"
          android:textSize="14sp" />

      <!-- VIDEO VIEW -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="6dp"
          android:text="🎬 Video "
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <!-- VIDEO DESCRIPTION -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Click to watch a short video of Gunung Hijau"
          android:textColor="#000000"
          android:textSize="14sp" />

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="160dp">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/playicon" />
      </FrameLayout>

      <!-- MAP IMAGE -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"

          android:text="📍 Location"
          android:textColor="#000000"
          android:textSize="16sp"
          android:textStyle="bold" />

      <ImageView
          android:id="@+id/mapImagegunung"
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:layout_marginBottom="0dp"
          android:clickable="true"
          android:contentDescription="Map to Gunung Hijau"
          android:textColor="#000000"
          android:focusable="true"
          android:scaleType="centerCrop"
          android:src="@drawable/gunung_map" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
